rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /students/{studentId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (request.auth.uid == studentId
          || studentId.matches('^' + request.auth.uid + '_legacy_[a-z0-9]+$'))
        && request.resource.data.keys().hasOnly(['updatedAt', 'legacy']);
      allow delete: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /curatorExhibits/{exhibitId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /{collectionName}/{documentId} {
      allow read: if signedIn()
        && collectionName in [
          'lectures',
          'presentations',
          'assignments',
          'quizzes',
          'exhibits'
        ];
      allow create, update, delete: if isAdmin()
        && collectionName in [
          'lectures',
          'presentations',
          'assignments',
          'quizzes',
          'exhibits'
        ];
    }
  }
}
